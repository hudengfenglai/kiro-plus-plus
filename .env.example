KIRO_PLUS_PROVIDER=openai-compatible
KIRO_PLUS_OPENAI_API_KEY=
KIRO_PLUS_OPENAI_BASE_URL=https://api.openai.com/v1
KIRO_PLUS_MODEL=gpt-4.1-mini
# Optional: expose multiple model ids in Kiro's picker.
# KIRO_PLUS_MODELS=gpt-4.1-mini,gpt-4.1
KIRO_PLUS_PORT=43119
KIRO_PLUS_LOG_BODIES=0
KIRO_PLUS_LOG_HEADERS=1

# Domestic OpenAI-compatible provider examples:
#
# DeepSeek:
# KIRO_PLUS_OPENAI_BASE_URL=https://api.deepseek.com
# KIRO_PLUS_MODEL=deepseek-v4-pro
# KIRO_PLUS_MODELS=deepseek-v4-pro,deepseek-v4-flash
#
# DashScope / Qwen:
# KIRO_PLUS_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KIRO_PLUS_MODEL=qwen-plus
#
# Moonshot / Kimi:
# KIRO_PLUS_OPENAI_BASE_URL=https://api.moonshot.cn/v1
# KIRO_PLUS_MODEL=kimi-k2.5
#
# Zhipu GLM:
# KIRO_PLUS_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# KIRO_PLUS_MODEL=glm-4.7
#
# SiliconFlow:
# KIRO_PLUS_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# KIRO_PLUS_MODEL=Qwen/Qwen3.5-35B-A3B
